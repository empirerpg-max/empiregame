   "source": [
    "# Célula 6 — Importar MÚSICAS\n",
    "print('\\n▶ Musicas')\n",
    "S = {'Nome':None,'Artista':None,'Album':None,'Capa da Musica':None,\n",
    "     'Link do audio':None,'telegram_file_id':None,'telegram_topic_id':None,\n",
    "     'genero':None,'tipo_single':None,'tipo_musica':None,'data_lancamento':None,'ordem':None}\n",
    "rows = ler_aba('Musicas','Músicas')\n",
    "reg = []\n",
    "for r in rows:\n",
    "    nome = r.get('Nome da música') or r.get('Nome')\n",
    "    if not nome: continue\n",
    "    reg.append(norm(S, {\n",
    "        'Nome': nome,\n",
    "        'Artista': r.get('ACT PRINCIPAL') or r.get('Artista'),\n",
    "        'Album': r.get('ALBUM'),\n",
    "        'Capa da Musica': r.get('Capa da música'),\n",
    "        'Link do audio': r.get('Link do áudio'),\n",
    "        'telegram_file_id': r.get('ID do arquivo'),\n",
    "        'telegram_topic_id': n(r.get('ID do tópico')),\n",
    "        'genero': r.get('GÊNERO'),\n",
    "        'tipo_single': r.get('TIPO DE SINGLE'),\n",
    "        'tipo_musica': r.get('TIPO DE MÚSICA'),\n",
    "        'data_lancamento': str(r['Data de lançamento']) if r.get('Data de lançamento') else None,\n",
    "        'ordem': n(r.get('Ordem')),\n",
    "    }))\n",
    "upsert('Musicas', reg)"
   ],
   "outputs": [],
   "execution_count": null
  },
