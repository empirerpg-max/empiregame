PORT=8083

# Mesmo bot token já usado no upload novo (Bot API) — o bot também precisa
# ser membro/admin do(s) canal(is) antigo(s) que serão lidos aqui.
TELEGRAM_BOT_TOKEN=

# Opcional: suas próprias credenciais de my.telegram.org, caso as
# credenciais públicas de fallback sejam recusadas (erro API_ID_INVALID).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
